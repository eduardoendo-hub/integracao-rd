RD_CRM_TOKEN=seu_token_aqui

# IRIS (cockpit real-time) — receive endpoint: POST {IRIS_WEBHOOK_URL}/api/webhook/rd
# Em produção: https://iris.technowhub.ai
IRIS_WEBHOOK_URL=https://iris.technowhub.ai
IRIS_WEBHOOK_SECRET=mude_este_segredo

# CORS — domínios das LPs que vão chamar este serviço
ALLOWED_ORIGINS=http://localhost:3000,https://impacta.com.br,https://www.impacta.com.br

LOG_LEVEL=INFO

# Meta Conversions API (server-side) — opcional. Se vazio, /api/pixel/event
# vira no-op. Token obtido em Meta Business Manager > Configuracoes da Conta
# do Pixel > Conjunto de dados > Acesso > Gerar token de acesso.
META_PIXEL_ID=2233020050842609
META_CAPI_TOKEN=cole_aqui_o_system_user_token
